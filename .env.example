# Copia este archivo como .env.local (local) o pon estas variables en Vercel → Settings → Environment Variables.
# Sin las dos de Supabase, la web funciona en "modo demostración" con el contenido inicial (sin panel ni formularios).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# URL pública final (para sitemap, canonical y Open Graph). Si usas el dominio de Vercel, puedes dejarla vacía.
NEXT_PUBLIC_SITE_URL=

# Código de verificación de Google Search Console (solo el valor de content="...")
NEXT_PUBLIC_GOOGLE_VERIFICATION=
